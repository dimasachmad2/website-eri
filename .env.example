# ── Frontend (Next.js @ Hostinger Business, Managed Node.js) ─────────────
# Public site URL (for canonical, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://envirors.id

# ── CMS (Directus @ Lightsail) — dipakai mulai Fase 2 ────────────────────
# Base URL API Directus
DIRECTUS_URL=https://cms.envirors.id
# Static token read-only untuk Next.js mengambil konten saat build/ISR
DIRECTUS_TOKEN=

# Secret bersama untuk memicu on-demand revalidation dari Directus/n8n
REVALIDATE_SECRET=ganti-dengan-string-acak-panjang
