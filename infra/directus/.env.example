# Salin jadi .env di server, lalu isi. JANGAN commit file .env.
PUBLIC_URL=https://cms.enviroresources.co.id

# Buat dengan: openssl rand -hex 32  (dua kali, nilai berbeda)
KEY=ganti-dengan-openssl-rand-hex-32
SECRET=ganti-dengan-openssl-rand-hex-32

# Login admin pertama Directus
ADMIN_EMAIL=admin@enviroresources.co.id
ADMIN_PASSWORD=ganti-password-kuat

# Database (internal, tidak terekspos ke internet)
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=ganti-password-db-kuat
